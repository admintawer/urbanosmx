<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_salary_rule_view_form_rail_accounting" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.rail.accounting</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="hr_payroll_account.hr_salary_rule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="inside">
                <group string="Cuentas especiales RAIL" colspan="4">
                    <field name="rail_account_mapping_ids" nolabel="1" colspan="4">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="active" optional="hide"/>
                            <field name="company_id" optional="hide"/>
                            <field name="side"/>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="account_id"/>
                            <field name="analytic_distribution" widget="analytic_distribution" groups="analytic.group_analytic_accounting" optional="hide"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
