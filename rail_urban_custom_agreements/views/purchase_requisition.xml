<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_bl_xlsx" model="ir.actions.report">
    <field name="name">Report BL Xlsx</field>
    <field name="model">purchase.requisition</field>
    <field name="report_type">xlsx</field>
    <field name="report_name">rail_urban_custom_agreements.report_xlsx</field>
    <field name="report_file">rail_urban_custom_agreements.report_xlsx</field>
    <field name="print_report_name">'BL Xlsx'</field>
  </record>

  <record model="ir.ui.view" id="rail_urban_agreement">
    <field name="name">rail.urban.agreement</field>
    <field name="model">purchase.requisition</field>
    <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header/button[@name='action_confirm']" position="before">
        <button name="send_email_with_xlsx" type="object" string="Enviar licitación"
                invisible="state not in ['draft', 'ongoing', 'sent']"/>
        <button type="action" name="%(import_blanket_action)d" string="Importar respuestas"
                context="{'default_vendor_ids': vendor_ids, 'default_requisition_id': id, 'default_subtype': subtype}"
                invisible="state not in ['draft', 'sent']"/>
        <button name="button_automatic_aproval" type="object" string="Asignación automática"
                invisible="manual_aproval or state not in ['draft', 'ongoing', 'sent']"/>
        <button name="button_manual_aproval" type="object" string="Asignación manual"
                invisible="not manual_aproval or state not in ['draft', 'ongoing', 'sent']"/>
      </xpath>

      <xpath expr="//header/field[@name='state']" position="attributes">
        <attribute name="statusbar_visible">draft,sent,in_progress,confirmed,done</attribute>
      </xpath>

      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="%(action_blanket_list)d" type="action" class="oe_stat_button" icon="fa-usd"
                invisible="state == 'draft'">
          <field name="bl_count" widget="statinfo" string="BLs"/>
        </button>
      </xpath>

      <field name="vendor_id" position="after">
        <field name="vendor_ids" readonly="state != 'draft'" required="1" widget="many2many_tags"/>
        <field name="vendor_emails" invisible="1"/>
        <field name="manual_aproval"/>
      </field>

      <field name="requisition_type" position="after">
        <field name="type_id" string="Sondeo de mercado"/>
        <field name="subtype" readonly="state != 'draft'"/>
      </field>

      <field name="reference" position="after">
        <field name="origin" placeholder="e.g. PO0025" readonly="state != 'draft'"/>
        <field name="ordering_date" readonly="state not in ['draft', 'in_progress', 'open', 'ongoing']"
               required="subtype == 'time_price'"/>
      </field>

      <xpath expr="//field[@name='line_ids']/list/field[@name='product_uom_id']" position="after">
        <field name="manual_aproval" column_invisible="True"/>
        <field name="schedule_date" readonly="not manual_aproval"/>
        <field name="vendor_id" readonly="not manual_aproval"/>
        <field name="purchase_id" readonly="1"/>
      </xpath>
      <xpath expr="//field[@name='line_ids']/list/field[@name='price_unit']" position="attributes">
        <attribute name="readonly">not manual_aproval</attribute>
      </xpath>
    </field>
  </record>
</odoo>
