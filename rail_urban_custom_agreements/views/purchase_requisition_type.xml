<odoo>
    <record id="urban_blanket_requisition_type" model="ir.ui.view">
        <field name="name">urban.blanket.requisition.type</field>
        <field name="model">purchase.requisition.type</field>
        <field name="arch" type="xml">
            <form string="Legacy Agreement Type">
              <sheet>
                <group>
                  <field name="name"/>
                  <field name="sequence"/>
                  <field name="exclusive"/>
                  <field name="quantity_copy"/>
                <field name="vendor_qty"/>
                </group>
              </sheet>
            </form>
        </field>
    </record>
</odoo>
