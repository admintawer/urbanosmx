<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="multi_approval_view_tree" model="ir.ui.view">
        <field name="name">multi_approval_view_tree</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <list string="Approvals" import="false">
                <field name="priority" widget="priority" />
                <field name="code"/>
                <field name="name" />
                <field name="description" optional="show"/>
                <field name="user_id" />
                <field name="request_date" />
                <field name="pic_ids" widget="many2many_tags" />
                <field name="deadline" />
                <field name="state" />
                <field name="is_pic" invisible="1"/>
                <button name="action_approve" type="object"
                    string="APROBAR"
                    invisible="is_pic == False or state != 'Submitted'"
                    class="oe_highlight" />
                <button name="%(rail_odoo_approvals.refused_reason_action)d" type="action"
                    invisible="is_pic == False or state != 'Submitted'"
                    string="RECHAZAR" 
                    class="btn btn-danger" 
                    confirm="Esta seguro(a) de rechazar esta solicitud"/>
            </list>
        </field>
    </record>
    <record id="multi_approval_view_filter" model="ir.ui.view">
        <field name="name">multi_approval_view_filter</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <search string="Approvals">
                <filter string="My Request" name="my_request" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <field name="code"/>
                <field name="name"/>
                <separator/>
                <filter string="My Approvals" name="my_approval" domain="[('pic_ids','in',[uid])]"/>
                <filter string="To Review" name="to_review" domain="[('pic_ids','in', [uid]), ('state', '=', 'Submitted')]"/>
                <separator/>
                <field name="user_id" />
                <field name="pic_ids" />
                <field name="type_id" />
                <group>
                    <filter string="User" name='user' context="{'group_by':'user_id'}"/>
                    <filter string="Type" name="type_id" context="{'group_by':'type_id'}"/>
                    <filter string="Status" name="status" context="{'group_by':'state'}"/>
                    <separator orientation="vertical" />
                    <filter string="Request Date" name="date" context="{'group_by':'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="multi_approval_view_form" model="ir.ui.view">
        <field name="name">multi_approval_view_form</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name='is_pic' invisible="1" />
                    <button name="action_submit" type="object"
                            string="Submit" invisible="state != 'Draft'"
                            class="oe_highlight" />
                    <button name="action_approve" type="object"
                            string="Approve"
                            invisible="is_pic == False or state != 'Submitted'"
                            class="oe_highlight" />
                    <button name="%(rail_odoo_approvals.refused_reason_action)d" type="action"
                            invisible="is_pic == False or state != 'Submitted'"
                            string="Refuse"/>
                    <widget name="attach_document" string="Attach Document" action="message_post"
                        invisible="attachment_number > 1 or id == False"/>
                    <widget name="attach_document" string="Attach Document" action="message_post"
                        highlight="1" invisible="attachment_number > 1 or id == False"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" invisible="state != 'Draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="Draft,Submitted,Approved,Cancel" />
                </header>
                <div class="alert alert-info" role="alert"
                     invisible="state != 'Submitted' or current_line_progress == ''">
                    <i class="fa fa-users me-2"/>
                    <strong>Aprobación Múltiple:</strong>
                    Esta línea requiere la aprobación de todos los usuarios.
                    <field name="current_line_progress" readonly="1" class="ms-2 badge bg-primary"/>
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" readonly="1"/>
                        </h1>

                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" placeholder="Title" readonly="state != 'Draft'"/>
                        </h1>
                        <field name="priority" widget="priority" readonly="state != 'Draft'"/>
                    </div>
                    <div style="background: rgb(245, 245, 245);margin: 0px !important;padding: 0px 10px;border: 1px solid rgb(207, 207, 207);">
                        <group>
                            <group>
                                <field name="user_id" readonly="1"/>
                                <field name="request_date" readonly="state != 'Draft'"/>
                                <field name="type_id" readonly="state != 'Draft'"
                                    options="{'no_create': True, 'no_open': True}"/>
                                <field name="deadline" readonly="1"/>
                                <field name="pic_ids" readonly="1" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="contact_id"
                                    invisible="contact_opt in ['None', False]"
                                    required="contact_opt == 'Required'"
                                    readonly="state != 'Draft'"/>
                                <field name="date"
                                    invisible="date_opt in ['None', False]"
                                    required="date_opt == 'Required'"
                                    readonly="state != 'Draft'"/>
                                <label for="date_start" string="Period" 
                                    invisible="period_opt in ['None',False]"/>
                                <div invisible="period_opt in ['None',False]">
                                    <div>
                                    <span>From: </span><field name="date_start" class="oe_inline" 
                                        required="period_opt == 'Required'"
                                        reqdonly="state != 'Draft'"/>
                                    </div>
                                    <div>
                                    <span>to: </span><field name="date_end" class="oe_inline" 
                                        required="period_opt == 'Required'"
                                        readonly="state != 'Draft'"/>
                                    </div>
                                </div>
                                <field name="item_id"
                                    invisible="item_opt in ['None',False]"
                                    required="item_opt == 'Required'"
                                    readonly="state != 'Draft'"/>
                                <field name="quantity"
                                    invisible="quantity_opt in ['None',False]"
                                    required="quantity_opt == 'Required'"
                                    readonly="state != 'Draft'"/>
                                <field name="amount"
                                    invisible="amount_opt in ['None',False]"
                                    required="amount_opt == 'Required'"
                                    readonly="state != 'Draft'"/>
                                <field name="payment"
                                    invisible="payment_opt in ['None', False]"
                                    required="payment_opt == 'Required'"
                                    readonly="state != 'Draft'"/>
                                <field name="reference"
                                    invisible="reference_opt in ['None',False]"
                                    required="reference_opt == 'Required'"
                                    readonly="state != 'Draft'"/>
                                <field name="location"
                                    invisible="location_opt in ['None',False]"
                                    required="location_opt == 'Required'"
                                    readonly="state != 'Draft'"/>
                            </group>
                        </group>
                        <group string="Items" 
                            invisible="multi_items_opt in ['None',False]" 
                            required="multi_items_opt == 'Required'"
                            readonly="state != 'Draft'">
                            <field name="item_ids"
                                nolabel="1"
                                colspan="2"
                                invisible="multi_items_opt in ['None',False]"
                                required="multi_items_opt == 'Required'"
                                readonly="state != 'Draft'"/>
                        </group>
                    </div>
                    
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1" placeholder='Description' readonly="state != 'Draft'"/>
                        </page>
                        <page string="Approver(s)" name="approver" invisible="state in ['Draft', 'Cancel']">
                            <field name="line_ids">
                                <list editable="top" create='false' delete='false'>
                                    <field name="name" readonly="1"/>
                                    <field name="user_ids" readonly="1" widget="many2many_tags"/>
                                    <field name="approved_user_ids" readonly="1" invisible="not require_all_approvers"
                                           widget="many2many_tags" optional="hide"/>
                                    <field name="pending_user_ids" readonly="1" invisible="not require_all_approvers"
                                           widget="many2many_tags" optional="hide"/>
                                    <field name="require_opt" readonly="1"/>
                                    <field name="require_all_approvers" readonly="1" optional="show"/>
                                    <field name="deadline" readonly="state not in ['draft','Waiting for Approval']"/>
                                    <field name="state" readonly="1"/>
                                    <field name="approval_progress" readonly="1" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Options" name="options" invisible="1">
                            <group string="Fields" name="option_settings">
                                <group>
                                    <field name="document_opt" widget="radio" options="{'horizontal': true}" />
                                    <field name="contact_opt" widget="radio" options="{'horizontal': true}" />
                                    <field name="date_opt" widget="radio" options="{'horizontal': true}" />
                                    <field name="period_opt" widget="radio" options="{'horizontal': true}" />
                                    <field name="item_opt" widget="radio" options="{'horizontal': true}" />
                                    <field name="multi_items_opt" widget="radio" options="{'horizontal': true}" />
                                </group>
                                <group>
                                    <field name="quantity_opt" widget="radio" options="{'horizontal': true}" />
                                    <field name="amount_opt" widget="radio" options="{'horizontal': true}" />
                                    <field name="payment_opt" widget="radio" options="{'horizontal': true}" />
                                    <field name="reference_opt" widget="radio" options="{'horizontal': true}" />
                                    <field name="location_opt" widget="radio" options="{'horizontal': true}" />
                                    <field name="attachment_number" invisible="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="multi_approval_view_kanban" model="ir.ui.view">
        <field name="name">multi_approval_view_kanban</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <kanban class="o_modules_kanban" import="false">
                <field name="name" />
                <field name="description"/>
                <field name="id" />
                <field name="image" />
                <field name="code" />
                <field name="state"/>
                <field name="is_pic"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <!--t t-if="record.id">
                                <img t-att-src="'/web/image/multi.approval/' + record.id.raw_value + '/image'" alt="Approval Image" class="oe_kanban_avatar float-left mr-3" width="64"
                                    height="64" />
                            </t-->
                            <div class="o_kanban_record_top mb16">
                                <div class="o_kanban_record_headings mt4">
                                    <strong class="o_kanban_record_title">
                                        <field name="code" />
                                    </strong>
                                </div>
                                <strong>
                                    <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'cancel': 'warning', 'approved': 'success', 'refused': 'danger'}}"/>
                                </strong>
                            </div>
                            <div class="row mb4">
                                <div class="col-6 o_kanban_record_headings">
                                    <span>Solicitud:</span><field name="request_date" widget="date"/>
                                </div>
                                <div class="col-6 text-end">
                                    <span>Limite:</span><field name="deadline"/>
                                </div>
                            </div>
                            <div class="oe_kanban_details d-flex flex-column justify-content-between">
                                <p class="oe_module_name">
                                    <field name="name" />
                                    <field name="description"/>
                                </p>
                                <p class="">
                                    <field name="priority" widget="priority" />
                                </p>
                            
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <button name="action_approve" type="object"
                                            string="APROBAR"
                                            invisible="is_pic == False or state != 'Submitted'"
                                            class="oe_highlight" />
                                        <button name="%(rail_odoo_approvals.refused_reason_action)d" type="action"
                                            invisible="is_pic == False or state != 'Submitted'"
                                            string="RECHAZAR" 
                                            class="btn btn-danger" 
                                            confirm="Esta seguro(a) de rechazar esta solicitud"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
