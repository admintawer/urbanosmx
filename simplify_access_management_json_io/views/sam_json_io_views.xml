<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sam_json_export_wizard_form" model="ir.ui.view">
        <field name="name">sam.json.export.wizard.form</field>
        <field name="model">sam.json.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar reglas JSON">
                <group>
                    <field name="info" readonly="1" nolabel="1"/>
                    <field name="filename" readonly="1"/>
                    <field name="file" filename="filename" readonly="1"/>
                </group>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_sam_json_import_wizard_form" model="ir.ui.view">
        <field name="name">sam.json.import.wizard.form</field>
        <field name="model">sam.json.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar reglas JSON">
                <group>
                    <field name="json_file" filename="json_filename" required="1"/>
                    <field name="json_filename" invisible="1"/>
                </group>
                <group string="Opciones">
                    <field name="update_existing"/>
                    <field name="import_users"/>
                    <field name="import_companies"/>
                    <field name="dry_run"/>
                </group>
                <group string="Resultado">
                    <field name="result_text" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importar / Validar" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sam_json_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar reglas JSON</field>
        <field name="res_model">sam.json.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_sam_json_import"
              name="Importar reglas JSON"
              parent="simplify_access_management.main_menu_simplify_access_management"
              action="action_sam_json_import_wizard"
              sequence="99"/>

    <record id="view_access_management_form_json_io" model="ir.ui.view">
        <field name="name">access.management.form.json.io</field>
        <field name="model">access.management</field>
        <field name="inherit_id" ref="simplify_access_management.access_management_form_view_ah"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_export_sam_json" type="object" class="oe_stat_button" icon="fa-download">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Exportar</span>
                        <span class="o_stat_text">JSON</span>
                    </div>
                </button>
                <button name="action_open_sam_json_import" type="object" class="oe_stat_button" icon="fa-upload">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Importar</span>
                        <span class="o_stat_text">JSON</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="action_sam_json_export_server" model="ir.actions.server">
        <field name="name">Exportar reglas JSON</field>
        <field name="model_id" ref="simplify_access_management.model_access_management"/>
        <field name="binding_model_id" ref="simplify_access_management.model_access_management"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_sam_json()</field>
    </record>
</odoo>
