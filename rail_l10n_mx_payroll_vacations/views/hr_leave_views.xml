<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rail_hr_leave_form_vacations" model="ir.ui.view">
        <field name="name">rail.hr.leave.form.vacations</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="rail_is_vacation_leave" invisible="1"/>
                <field name="rail_vacation_available_days" readonly="1" invisible="not rail_is_vacation_leave"/>
                <field name="rail_vacation_line_id" invisible="not rail_is_vacation_leave" readonly="state in ['cancel', 'refuse', 'validate', 'validate1']"/>
                <field name="rail_vacation_advanced_days" readonly="1" invisible="not rail_vacation_advanced_days"/>
            </xpath>
        </field>
    </record>

    <record id="rail_hr_leave_form_manager_vacations" model="ir.ui.view">
        <field name="name">rail.hr.leave.form.manager.vacations</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Consumo vacaciones MX" invisible="not rail_vacation_consumption_ids" groups="hr_holidays.group_hr_holidays_user">
                    <field name="rail_vacation_consumption_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="vacation_line_id"/>
                            <field name="days"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
