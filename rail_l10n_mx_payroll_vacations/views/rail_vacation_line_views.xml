<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rail_vacation_line_view_list" model="ir.ui.view">
        <field name="name">rail.vacation.line.list</field>
        <field name="model">rail.vacation.line</field>
        <field name="arch" type="xml">
            <list string="Saldos vacacionales MX" multi_edit="1">
                <field name="employee_id"/>
                <field name="seniority_start_date" optional="show"/>
                <field name="seniority_years" optional="show"/>
                <field name="anniversary_date" optional="show"/>
                <field name="year"/>
                <field name="state"/>
                <field name="granted_days"/>
                <field name="used_days"/>
                <field name="remaining_days"/>
                <field name="origin"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="rail_vacation_line_view_form" model="ir.ui.view">
        <field name="name">rail.vacation.line.form</field>
        <field name="model">rail.vacation.line</field>
        <field name="arch" type="xml">
            <form string="Saldo vacacional MX">
                <header>
                    <button name="action_activate" type="object" string="Activar" invisible="state == 'active'"/>
                    <button name="action_close" type="object" string="Cerrar" invisible="state == 'closed'"/>
                    <button name="action_expire" type="object" string="Vencer" invisible="state == 'expired'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,closed,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="version_id"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group string="Antigüedad aplicada">
                            <field name="seniority_start_date"/>
                            <field name="seniority_years"/>
                            <field name="anniversary_date"/>
                            <field name="year"/>
                            <field name="origin"/>
                        </group>
                    </group>
                    <group>
                        <group string="Saldo">
                            <field name="granted_days"/>
                            <field name="used_days"/>
                            <field name="remaining_days" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" nolabel="1" placeholder="Notas..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rail_vacation_line_action" model="ir.actions.act_window">
        <field name="name">Saldos vacacionales MX</field>
        <field name="res_model">rail.vacation.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <menuitem id="rail_vacation_line_menu"
              name="Saldos vacacionales MX"
              parent="hr_holidays.menu_hr_holidays_report"
              action="rail_vacation_line_action"
              sequence="20"
              groups="hr_holidays.group_hr_holidays_user"/>
</odoo>
