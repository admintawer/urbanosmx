<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rail_hr_payslip_run_form_payroll_base" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.rail.payroll.base</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <!--
                Odoo 19 keeps the responsibilities separated:
                - rail_payroll_alias is the manual/business label of the payroll batch.
                - name remains the technical name generated by Odoo.
                - rail_l10n_mx_payroll_type filters the salary structure.
                - structure_id is the native salary structure used by the batch.
                - schedule_pay remains the native payment calendar/frequency and drives period dates.
            -->
            <xpath expr="//field[@name='structure_id']" position="before">
                <field name="rail_payroll_alias" placeholder="Ej. 1a Quincena Octubre 2026"/>
                <field name="rail_l10n_mx_payroll_type"/>
            </xpath>
            <xpath expr="//field[@name='structure_id']" position="attributes">
                <attribute name="domain">[('l10n_mx_payroll_type', '=', rail_l10n_mx_payroll_type)]</attribute>
            </xpath>
            <xpath expr="//field[@name='schedule_pay']" position="after">
                <field name="rail_payroll_number"/>
            </xpath>
            <xpath expr="//field[@name='date_end']" position="after">
                <field name="rail_period_days"/>
            </xpath>
        </field>
    </record>

    <record id="rail_hr_payslip_run_tree_payroll_base" model="ir.ui.view">
        <field name="name">hr.payslip.run.list.rail.payroll.base</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="rail_payroll_alias" string="Alias de nómina" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="rail_hr_payslip_run_kanban_payroll_base" model="ir.ui.view">
        <field name="name">hr.payslip.run.kanban.rail.payroll.base</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <br/>
                <field name="rail_payroll_alias" class="text-muted"/>
            </xpath>
        </field>
    </record>

    <record id="rail_hr_payslip_run_search_payroll_base" model="ir.ui.view">
        <field name="name">hr.payslip.run.search.rail.payroll.base</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="rail_payroll_alias" string="Alias de nómina"/>
            </xpath>
        </field>
    </record>
</odoo>
