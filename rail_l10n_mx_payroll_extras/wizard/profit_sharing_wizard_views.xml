<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="reparto_utilidades_wizard" model="ir.ui.view">
        <field name="name">Reparto utilidades wizard</field>
        <field name="model">repart.outilidades.wizard</field>
        <field name="arch" type="xml">
            <form string="Cálculo Reparto Utilidades">
                <group col="4">
                    <field name="ano"/>
                    <field name="total_repartir"/>
                    <field name="date_slip"/>
                    <field name="structure_id"/>
                    <field name="state" invisible="1"/>
                </group>
                <group string="Resumen" invisible="state == 'draft'">
                    <field name="total_nomina"/>
                    <field name="total_dias"/>
                    <field name="coef_monto"/>
                    <field name="coef_dias"/>
                    <field name="payslip_run_id" invisible="not payslip_run_id"/>
                </group>
                <field name="line_ids" invisible="not line_ids">
                    <list create="0" delete="0" edit="0">
                        <field name="employee_id"/>
                        <field name="salary_accumulated" sum="Total"/>
                        <field name="days_accumulated" sum="Total"/>
                        <field name="ptu_salary" sum="Total"/>
                        <field name="ptu_days" sum="Total"/>
                        <field name="raw_total" sum="Total"/>
                        <field name="daily_wage"/>
                        <field name="max_limit"/>
                        <field name="total" sum="Total"/>
                    </list>
                </field>
                <field name="file_data" invisible="1"/>
                <field name="file_name" invisible="1"/>
                <footer>
                    <button name="action_calculate" string="Calcular" type="object" class="btn-primary"/>
                    <button name="reparto_utilidades_data" string="Exportar XLSX" type="object" class="btn-secondary"/>
                    <button name="reparto_utilidades_payslip" string="Procesamiento" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="reparto_utilidades_wizard_action" model="ir.actions.act_window">
        <field name="name">Reparto utilidades</field>
        <field name="res_model">repart.outilidades.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="reparto_utilidades_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
