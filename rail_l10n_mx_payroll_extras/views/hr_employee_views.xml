<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rail_hr_employee_form_payroll_extras" model="ir.ui.view">
        <field name="name">rail.hr.employee.form.payroll.extras</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_rail_open_loans"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        type="object"
                        groups="hr_payroll.group_hr_payroll_user">
                    <field name="rail_loan_count" string="Préstamos" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='payroll_group']" position="after">
                <group name="rail_payroll_extras_employee" string="Extras de nómina MX" groups="hr_payroll.group_hr_payroll_user">
                    <field name="loan_request"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
