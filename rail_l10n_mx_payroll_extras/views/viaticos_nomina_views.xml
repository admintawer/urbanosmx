<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_viaticos_nomina_list" model="ir.ui.view">
        <field name="name">viaticos.nomina.list</field>
        <field name="model">viaticos.nomina</field>
        <field name="arch" type="xml">
            <list string="Viáticos">
                <header>
                    <button name="action_generate_delivery_payslips" string="Generar nómina de entrega" type="object" class="oe_highlight"/>
                    <button name="action_generate_check_payslips" string="Generar nómina de comprobación" type="object"/>
                </header>
                <field name="name"/>
                <field name="fecha"/>
                <field name="employee_id"/>
                <field name="entregas"/>
                <field name="comprobaciones"/>
                <field name="por_comprobar"/>
                <field name="delivery_payslip_count" string="Recibos entrega" optional="show"/>
                <field name="check_payslip_count" string="Recibos comprobación" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_viaticos_nomina_form" model="ir.ui.view">
        <field name="name">viaticos.nomina.form</field>
        <field name="model">viaticos.nomina</field>
        <field name="arch" type="xml">
            <form string="Viáticos">
                <header>
                    <button name="action_generate_delivery_payslips"
                            string="Generar nómina de entrega"
                            type="object"
                            class="oe_highlight"
                            invisible="state == 'closed'"
                            confirm="Se generará un recibo extraordinario calculado para las entregas con CFDI pendientes."/>
                    <button name="action_generate_check_payslips"
                            string="Generar nómina de comprobación"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'open'"
                            confirm="Se generará un recibo extraordinario calculado para las comprobaciones con CFDI pendientes."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_delivery_payslip" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="delivery_payslip_count == 0">
                            <field name="delivery_payslip_count" widget="statinfo" string="Recibos entrega"/>
                        </button>
                        <button name="action_view_check_payslip" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="check_payslip_count == 0">
                            <field name="check_payslip_count" widget="statinfo" string="Recibos comprobación"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="fecha" readonly="state == 'closed'"/>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="version_id" readonly="1"/>
                            <field name="description"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="entregas" readonly="1"/>
                            <field name="comprobaciones" readonly="1"/>
                            <field name="por_comprobar" readonly="1"/>
                            <field name="delivery_payslip_id" readonly="1"/>
                            <field name="check_payslip_id" readonly="1"/>
                            <field name="delivery_payslip_run_id" readonly="1"/>
                            <field name="check_payslip_run_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Entregas">
                            <field name="entregas_ids" readonly="state == 'closed'">
                                <list editable="bottom">
                                    <field name="fecha"/>
                                    <field name="referencia"/>
                                    <field name="cfdi"/>
                                    <field name="generado" readonly="1"/>
                                    <field name="payslip_id" readonly="1" optional="show"/>
                                    <field name="importe" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comprobaciones">
                            <field name="comprobaciones_ids" readonly="state == 'closed'">
                                <list editable="bottom">
                                    <field name="fecha"/>
                                    <field name="referencia"/>
                                    <field name="cfdi"/>
                                    <field name="generado" readonly="1"/>
                                    <field name="payslip_id" readonly="1" optional="show"/>
                                    <field name="importe" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observaciones">
                            <field name="observaciones"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_viaticos_nomina" model="ir.actions.act_window">
        <field name="name">Viáticos</field>
        <field name="res_model">viaticos.nomina</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
