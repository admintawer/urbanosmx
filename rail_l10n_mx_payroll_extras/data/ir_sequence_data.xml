<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_employee_loan" model="ir.sequence">
        <field name="name">Secuencia de préstamo de nómina</field>
        <field name="code">employee.loan</field>
        <field name="prefix">PRES/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_viaticos_nomina" model="ir.sequence">
        <field name="name">Secuencia de viáticos de nómina</field>
        <field name="code">viaticos.nomina</field>
        <field name="prefix">VIAT/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
