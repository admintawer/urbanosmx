    <record id="salary_rule_liquidation_isr" model="hr.salary.rule">
        <field name="name">FRB - ISR Art. 95 LISR</field>
        <field name="code">ISR2</field>
        <field name="sequence">710</field>
        <field name="struct_id" ref="structure_liquidation"/>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">def find_rates(x, rates):
    for low, high, fix, rate in rates:
        if low &lt;= x &lt;= high:
            return low, fix, rate
    return 0.0, 0.0, 0.0

taxable_amount = categories['GROSS']
monthly_table = payslip._rule_parameter('l10n_mx_isr_tables')['monthly']
if taxable_amount &gt; 0:
    low, fix, rate = find_rates(taxable_amount, monthly_table)
    calculated_isr = max((taxable_amount - low) * rate + fix, 0.0)
    daily_min_wage = payslip._rule_parameter('l10n_mx_daily_min_wage')
    days_per_month = payslip._rule_parameter('l10n_mx_days_per_month')
    result = 0.0 if taxable_amount &lt;= daily_min_wage * days_per_month else -round(calculated_isr, 2)
else:
    result = 0.0</field>
        <field name="l10n_mx_concept" ref="l10n_mx_hr_payroll_account_edi.l10n_mx_concept_d2"/>
    </record>

