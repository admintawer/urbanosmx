    <record id="salary_rule_ptu_isr" model="hr.salary.rule">
        <field name="name">FRB - ISR (sp) PTU</field>
        <field name="code">ISR2</field>
        <field name="sequence">700</field>
        <field name="struct_id" ref="structure_ptu"/>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">def find_rates(x, rates):
    for low, high, fix, rate in rates:
        if low &lt;= x &lt;= high:
            return low, fix, rate
    return 0.0, 0.0, 0.0

taxable_ptu = result_rules['PG011']['total']
monthly_salary = version._get_contract_wage()
isr_monthly_table = payslip._rule_parameter('l10n_mx_isr_tables')['monthly']
if taxable_ptu &gt; 0 and monthly_salary &gt; 0:
    monthly_fraction = taxable_ptu * 30.4 / payslip.l10n_mx_days_of_year
    low_1, fix_1, rate_1 = find_rates(monthly_salary + monthly_fraction, isr_monthly_table)
    tax_with_ptu = (monthly_salary + monthly_fraction - low_1) * rate_1 + fix_1
    low_2, fix_2, rate_2 = find_rates(monthly_salary, isr_monthly_table)
    tax_without_ptu = (monthly_salary - low_2) * rate_2 + fix_2
    tax_fraction = tax_with_ptu - tax_without_ptu
    effective_rate = tax_fraction / monthly_fraction if monthly_fraction else 0.0
    result = -round(taxable_ptu * effective_rate, 2)
else:
    result = 0.0</field>
        <field name="l10n_mx_concept" ref="l10n_mx_hr_payroll_account_edi.l10n_mx_concept_d2"/>
    </record>

